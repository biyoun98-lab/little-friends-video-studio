# Keep secrets in deployment environment variables; never commit real keys.
FAL_KEY=your_fal_api_key
# Defaults to alibaba/wan-3.0-prime/text-to-video
FAL_VIDEO_MODEL=alibaba/wan-3.0-prime/text-to-video
PORT=3000

# Optional: URL of a separately hosted LongCat GPU worker (must use HTTPS in production).
LONGCAT_API_URL=
# Optional bearer token shared with the LongCat worker.
LONGCAT_API_TOKEN=
